void weather_fetch_and_display(void) {
    char *buffer = (char *)malloc(2048);
    if (!buffer) {
        ESP_LOGE(TAG, "Failed to allocate buffer");
        return;
    }

    // Show loading
    lvgl_port_lock(0);
    lv_label_set_text(weather_icon_label, LV_SYMBOL_REFRESH);
    lv_label_set_text(weather_temp_label, "Loading...");
    lv_label_set_text(weather_humidity_label, "Loading...");
    lvgl_port_unlock();

    // Fetch daily weather
    char url[256];
    snprintf(url, sizeof(url), "https://api.openweathermap.org/data/2.5/weather?lat=%s&lon=%s&appid=%s&units=imperial", WEATHER_LAT, WEATHER_LON, OPENWEATHERKEY);
    ESP_LOGI(TAG, "URL: %s", url);

    // Fetch weekly forecast
    char weekly_url[256];
    snprintf(weekly_url, sizeof(weekly_url), "https://api.openweathermap.org/data/2.5/onecall?lat=%s&lon=%s&exclude=current,minutely,hourly,alerts&appid=%s&units=imperial", WEATHER_LAT, WEATHER_LON, OPENWEATHERKEY);
    ESP_LOGI(TAG, "Weekly URL: %s", weekly_url);

    // Initialize HTTP client for daily weather
    esp_http_client_config_t config = {
        .url = url,
        .method = HTTP_METHOD_GET,
        .cert_pem = NULL,
        .use_global_ca_store = true,
        .crt_bundle_attach = esp_crt_bundle_attach,
        .timeout_ms = 10000,
        .buffer_size = 2048,
        .buffer_size_tx = 2048,
    };

    esp_http_client_handle_t client = esp_http_client_init(&config);
    if (!client) {
        ESP_LOGE(TAG, "Failed to init HTTP client");
        free(buffer);
        return;
    }

    // Fetch daily weather data
    esp_err_t err = esp_http_client_open(client, 0);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to open HTTP client: %s", esp_err_to_name(err));
        esp_http_client_cleanup(client);
        free(buffer);
        return;
    }

    // Read and process daily weather data...

    // Now fetch weekly forecast
    esp_http_client_config_t weekly_config = {
        .url = weekly_url,
        .method = HTTP_METHOD_GET,
        .cert_pem = NULL,
        .use_global_ca_store = true,
        .crt_bundle_attach = esp_crt_bundle_attach,
        .timeout_ms = 10000,
        .buffer_size = 2048,
        .buffer_size_tx = 2048,
    };

    esp_http_client_handle_t weekly_client = esp_http_client_init(&weekly_config);
    if (!weekly_client) {
        ESP_LOGE(TAG, "Failed to init HTTP client for weekly forecast");
        free(buffer);
        return;
    }

    // Fetch weekly weather data
    err = esp_http_client_open(weekly_client, 0);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Failed to open HTTP client for weekly forecast: %s", esp_err_to_name(err));
        esp_http_client_cleanup(weekly_client);
        free(buffer);
        return;
    }

    // Read and process weekly weather data...

    esp_http_client_close(client);
    esp_http_client_cleanup(client);
    esp_http_client_close(weekly_client);
    esp_http_client_cleanup(weekly_client);
    free(buffer);
}